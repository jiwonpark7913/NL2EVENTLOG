[
  {
    "activity": "Degree Examination Taken",
    "table": "degree_examination_result",
    "timestamp_column": "examination_date",
    "case_column": "student_id",
    "event_key": [
      "result_id"
    ],
    "key_sql": "'EX:' || result_id",
    "from_sql": "degree_examination_result"
  },
  {
    "activity": "Course Registered",
    "table": "registration",
    "timestamp_column": "registration_time",
    "case_column": "student_id",
    "event_key": [
      "student_id",
      "course_id"
    ],
    "key_sql": "'REG:' || student_id || ':' || course_id",
    "from_sql": "registration"
  },
  {
    "activity": "Assignment Graded",
    "table": "assignment_grading",
    "timestamp_column": "g.grading_time",
    "case_column": "a.student_id",
    "event_key": [
      "assignment_id",
      "instructor_id",
      "grading_time"
    ],
    "key_sql": "'GRADE:' || g.assignment_id || ':' || g.instructor_id || ':' || g.grading_time",
    "from_sql": "assignment_grading g JOIN assignment a ON a.assignment_id=g.assignment_id",
    "case_path": [
      "assignment_grading.assignment_id",
      "assignment.assignment_id",
      "assignment.student_id"
    ]
  },
  {
    "activity": "Simulation Experiment Completed",
    "table": "student_simulation_experiment_result",
    "timestamp_column": "simulation_date",
    "case_column": "student_id",
    "event_key": [
      "student_id",
      "module_id",
      "simulation_date"
    ],
    "key_sql": "'SIM:' || student_id || ':' || module_id || ':' || simulation_date",
    "from_sql": "student_simulation_experiment_result"
  },
  {
    "activity": "Thesis Submitted",
    "table": "thesis",
    "timestamp_column": "submission_date",
    "case_column": "student_id",
    "event_key": [
      "thesis_id"
    ],
    "key_sql": "'THESIS:' || thesis_id",
    "from_sql": "thesis"
  }
]
