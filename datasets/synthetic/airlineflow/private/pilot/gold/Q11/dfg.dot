digraph D {
graph [rankdir=TB, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.38];
node [shape=box, style="rounded,filled", color="#8ba6b6", fillcolor="#edf4f7", fontname="Arial", fontsize=11, margin="0.16,0.1"];
edge [color="#667d8b", fontname="Arial", fontsize=10, arrowsize=0.65];
start [shape=ellipse,label="Start",fillcolor="#e3f3e8"];
end [shape=ellipse,label="End",fillcolor="#f7e5e1"];
n0 [label="Boarding Start\n96 buckets"];
n1 [label="Boarding Close\n96 buckets"];
start -> n0 [label="96"];
n0 -> n1 [label="96"];
n1 -> end [label="96"];
}