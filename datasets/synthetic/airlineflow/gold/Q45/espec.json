{
  "schema": "authored_l15_reference_v1",
  "query_id": "Q45",
  "case_entity": "Flight",
  "case_identity": {
    "table": "flights",
    "key": [
      "flight_id"
    ]
  },
  "case_scope": "Observed events attributed to Flight; outbound flights only",
  "rules": [
    {
      "key": "CLC",
      "activity": "Cabin Cleaning Complete",
      "source_table": "handling_jobs",
      "source_row_key": "job_id",
      "timestamp_column": "finished_at",
      "carrier_column": "job_code",
      "carrier_value": "CL",
      "path": [
        [
          "turn_id",
          "turnarounds",
          "turn_id"
        ]
      ],
      "case_key": "outbound_id",
      "logical_depth": 2,
      "physical_depth": 1,
      "scope_outbound": false,
      "role": "outbound",
      "encoding": "Carrier-driven"
    },
    {
      "key": "BD",
      "activity": "Passenger Boarding Confirmed",
      "source_table": "passenger_actions",
      "source_row_key": "action_id",
      "timestamp_column": "action_at",
      "carrier_column": "action_code",
      "carrier_value": "BD",
      "path": [
        [
          "leg_id",
          "passenger_legs",
          "leg_id"
        ]
      ],
      "case_key": "flight_id",
      "logical_depth": 2,
      "physical_depth": 1,
      "scope_outbound": true,
      "role": "outbound",
      "encoding": "Carrier-driven"
    }
  ],
  "timestamp_policy": "Actual occurrence; KST as stored",
  "output_columns": [
    "case_id",
    "activity",
    "timestamp"
  ],
  "event_combination": "UNION ALL; preserve multiplicity"
}
