digraph G {
rankdir=LR; graph [bgcolor="white",pad=0.2,nodesep=0.35,ranksep=0.6]; node [shape=box,style="rounded,filled",fillcolor="#eaf2f6",color="#607b8b",fontname="Arial",fontsize=11]; edge [color="#728899",fontname="Arial",fontsize=10];
start [label="Start",shape=oval,fillcolor="#e1f2e7"]; end [label="End",shape=oval,fillcolor="#f7e4e4"];
n0 [label="In-block\n100"];
n1 [label="Off-block\n100"];
n0 -> end [label="100"];
n1 -> n0 [label="100"];
start -> n1 [label="100"];
}
