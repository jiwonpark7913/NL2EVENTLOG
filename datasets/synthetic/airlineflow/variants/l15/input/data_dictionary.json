{
  "flights": {
    "description": "날짜별 운항편. 입항편과 출항편 모두 저장한다. 편명은 날짜가 다르면 반복된다.",
    "columns": {
      "flight_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "운항편 ID"
      },
      "flight_no": {
        "declaration": "TEXT NOT NULL",
        "description": "공시 편명"
      },
      "scheduled_offblock": {
        "declaration": "TEXT NOT NULL",
        "description": "계획 주기장 출발 시각"
      },
      "scheduled_inblock": {
        "declaration": "TEXT NOT NULL",
        "description": "계획 주기장 도착 시각"
      }
    }
  },
  "turnarounds": {
    "description": "동일 기체의 입항편과 다음 출항편을 잇는 지상 체류 건. 본 예시는 기체 교체 없이 각 입항·출항이 한 번만 연결된다.",
    "columns": {
      "turn_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "턴어라운드 ID"
      },
      "inbound_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "입항 운항편"
      },
      "outbound_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "다음 출항 운항편"
      },
      "handling_started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "지상조업 실제 시작 시각"
      },
      "ready_at": {
        "declaration": "TEXT NOT NULL",
        "description": "항공기 출발 준비 완료 시각"
      }
    }
  },
  "boarding_sessions": {
    "description": "편 단위 탑승 운영 세션. 예시에서는 회항·재개 없음.",
    "columns": {
      "session_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "세션 ID"
      },
      "flight_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "운항편"
      },
      "started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "승객 탑승 개시 시각"
      },
      "closed_at": {
        "declaration": "TEXT NOT NULL",
        "description": "승객 탑승 마감 시각"
      }
    }
  },
  "handling_jobs": {
    "description": "지상조업 작업 지시 및 완료 기록.",
    "columns": {
      "job_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "작업 ID"
      },
      "turn_id": {
        "declaration": "TEXT NOT NULL REFERENCES turnarounds(turn_id)",
        "description": "담당 지상준비 건"
      },
      "job_code": {
        "declaration": "TEXT NOT NULL",
        "description": "BL = 수하물 탑재 마감, CL = 청소, DP = 승객 하차, UL = 수하물 하역, FU = 급유, CA = 기내식 적재"
      },
      "started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "현장 작업 시작 시각"
      },
      "finished_at": {
        "declaration": "TEXT NOT NULL",
        "description": "현장 작업 완료 시각"
      },
      "posted_at": {
        "declaration": "TEXT NOT NULL",
        "description": "전산 등록 시각"
      }
    }
  },
  "movement_reports": {
    "description": "입항·출항 운항편의 예정·실제 운항 메시지.",
    "columns": {
      "report_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "메시지 ID"
      },
      "flight_id": {
        "declaration": "TEXT NOT NULL REFERENCES flights(flight_id)",
        "description": "운항편"
      },
      "kind": {
        "declaration": "TEXT NOT NULL",
        "description": "EST = 예상 주기장 출발, OUT = 실제 주기장 출발, AIR = 실제 이륙, LAND = 실제 착륙, IN = 실제 주기장 도착"
      },
      "value_at": {
        "declaration": "TEXT NOT NULL",
        "description": "메시지가 가리키는 시각"
      },
      "received_at": {
        "declaration": "TEXT NOT NULL",
        "description": "메시지 수신 시각"
      }
    }
  },
  "bookings": {
    "description": "일행의 예약.",
    "columns": {
      "booking_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "예약 ID"
      },
      "booked_at": {
        "declaration": "TEXT NOT NULL",
        "description": "예약 생성 시각"
      }
    }
  },
  "passengers": {
    "description": "가명 승객 명부. 국적은 예시에서 기록된 단일 국적이며 출생국·거주국·여권 발급국과 구분한다. 생년월일은 사건 발생 시각이 아니다.",
    "columns": {
      "passenger_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "내부 합성 승객 식별자. 여권 번호가 아님"
      },
      "display_name": {
        "declaration": "TEXT NOT NULL",
        "description": "가상 승객 표시명"
      },
      "date_of_birth": {
        "declaration": "DATE NOT NULL",
        "description": "생년월일. YYYY-MM-DD. 사건 발생 시각이 아닌 승객 속성"
      },
      "nationality_code": {
        "declaration": "TEXT CHECK (nationality_code IS NULL OR length(nationality_code)=2)",
        "description": "기록된 국적의 두 자리 코드. KR/JP/US/DE/SG. 예시 가정상 하나만 기록, NULL은 미확인"
      },
      "gender_code": {
        "declaration": "TEXT NOT NULL CHECK (gender_code IN ('MALE','FEMALE','UNKNOWN'))",
        "description": "원천 승객 정보의 성별 코드. 예시 로컬 코드 체계이며 UNKNOWN은 미확인"
      }
    }
  },
  "tickets": {
    "description": "승객에게 발행한 항공권.",
    "columns": {
      "ticket_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "항공권 ID"
      },
      "booking_id": {
        "declaration": "TEXT NOT NULL REFERENCES bookings(booking_id)",
        "description": "관련 예약"
      },
      "passenger_id": {
        "declaration": "TEXT NOT NULL REFERENCES passengers(passenger_id)",
        "description": "명의 승객"
      }
    }
  },
  "passenger_legs": {
    "description": "승객이 특정 편을 이용하는 항공권 구간.",
    "columns": {
      "leg_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "승객 탑승 구간 ID"
      },
      "ticket_id": {
        "declaration": "TEXT NOT NULL REFERENCES tickets(ticket_id)",
        "description": "항공권"
      },
      "flight_id": {
        "declaration": "TEXT NOT NULL REFERENCES flights(flight_id)",
        "description": "운항편"
      }
    }
  },
  "passenger_actions": {
    "description": "승객 탑승 구간의 출발수속 기록.",
    "columns": {
      "action_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "처리 기록 ID"
      },
      "leg_id": {
        "declaration": "TEXT NOT NULL REFERENCES passenger_legs(leg_id)",
        "description": "탑승 구간"
      },
      "action_code": {
        "declaration": "TEXT NOT NULL",
        "description": "CK = 체크인 완료, BD = 탑승 확인, RJ = 판독 거절"
      },
      "action_at": {
        "declaration": "TEXT NOT NULL",
        "description": "현장 처리 시각"
      }
    }
  },
  "bag_legs": {
    "description": "위탁 수하물의 구간별 운송 기록.",
    "columns": {
      "bag_leg_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "가방 운송 구간 ID"
      },
      "leg_id": {
        "declaration": "TEXT NOT NULL REFERENCES passenger_legs(leg_id)",
        "description": "위탁한 승객 탑승 구간"
      },
      "bag_tag": {
        "declaration": "TEXT NOT NULL",
        "description": "수하물 태그"
      }
    }
  },
  "bag_scans": {
    "description": "수하물 한 개별 이동 스캔.",
    "columns": {
      "scan_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "스캔 ID"
      },
      "bag_leg_id": {
        "declaration": "TEXT NOT NULL REFERENCES bag_legs(bag_leg_id)",
        "description": "가방 운송 구간"
      },
      "scan_code": {
        "declaration": "TEXT NOT NULL",
        "description": "ACC = 접수, LD = 기내 화물칸 탑재"
      },
      "scanned_at": {
        "declaration": "TEXT NOT NULL",
        "description": "현장 스캔 시각"
      }
    }
  },
  "checkpoints": {
    "description": "공항 보안검색 구역.",
    "columns": {
      "checkpoint_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "검색장 ID"
      },
      "zone": {
        "declaration": "TEXT NOT NULL",
        "description": "검색장 구역명"
      }
    }
  },
  "security_visits": {
    "description": "공항 연계 자료. 승객이 특정 검색장에 한 번 방문한 건.",
    "columns": {
      "visit_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "방문 ID"
      },
      "leg_id": {
        "declaration": "TEXT NOT NULL REFERENCES passenger_legs(leg_id)",
        "description": "연계된 승객 탑승 구간"
      },
      "checkpoint_id": {
        "declaration": "TEXT NOT NULL REFERENCES checkpoints(checkpoint_id)",
        "description": "검색장"
      }
    }
  },
  "security_events": {
    "description": "검색장 방문별 관측 지점 기록.",
    "columns": {
      "event_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "관측 ID"
      },
      "visit_id": {
        "declaration": "TEXT NOT NULL REFERENCES security_visits(visit_id)",
        "description": "검색장 방문"
      },
      "point": {
        "declaration": "TEXT NOT NULL",
        "description": "Q = 대기열 진입, S = 검색 시작, C = 검색 완료"
      },
      "observed_at": {
        "declaration": "TEXT NOT NULL",
        "description": "현장 관측 시각"
      },
      "received_at": {
        "declaration": "TEXT NOT NULL",
        "description": "연계 서버 수신 시각"
      }
    }
  }
}