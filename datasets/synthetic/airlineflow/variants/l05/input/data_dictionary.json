{
  "flights": {
    "description": "Dated operating legs, including both inbound and outbound flights. Flight numbers repeat across dates.",
    "columns": {
      "flight_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "Operating leg identifier."
      },
      "flight_no": {
        "declaration": "TEXT NOT NULL",
        "description": "Published flight number."
      },
      "scheduled_offblock": {
        "declaration": "TEXT NOT NULL",
        "description": "Scheduled off-block time."
      },
      "scheduled_inblock": {
        "declaration": "TEXT NOT NULL",
        "description": "Scheduled in-block time."
      }
    }
  },
  "turnarounds": {
    "description": "Ground stay linking an inbound leg to the next outbound leg operated by the same aircraft. This dataset assumes no aircraft swaps and at most one link per leg in each role.",
    "columns": {
      "turn_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "Turnaround identifier."
      },
      "inbound_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "Inbound operating leg."
      },
      "outbound_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "Next outbound operating leg."
      },
      "handling_started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual start of ground handling."
      },
      "ready_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual aircraft ready time."
      }
    }
  },
  "boarding_sessions": {
    "description": "Flight-level boarding sessions. This example does not model diversions or reopened boarding.",
    "columns": {
      "session_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "Boarding session identifier."
      },
      "flight_id": {
        "declaration": "TEXT NOT NULL UNIQUE REFERENCES flights(flight_id)",
        "description": "Operating leg."
      },
      "started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual start of passenger boarding."
      },
      "closed_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual close of passenger boarding."
      }
    }
  },
  "handling_jobs": {
    "description": "Ground handling work orders and completion records.",
    "columns": {
      "job_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "Handling job identifier."
      },
      "turn_id": {
        "declaration": "TEXT NOT NULL REFERENCES turnarounds(turn_id)",
        "description": "Turnaround served by the job."
      },
      "job_code": {
        "declaration": "TEXT NOT NULL",
        "description": "BL = baggage loading close; CL = cabin cleaning; DP = disembarkation; UL = baggage unloading; FU = refuelling; CA = catering loading."
      },
      "started_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual job start time."
      },
      "finished_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Actual job completion time."
      },
      "posted_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Time the record was posted to the system."
      }
    }
  },
  "movement_reports": {
    "description": "Estimated and actual movement messages for inbound and outbound operating legs.",
    "columns": {
      "report_id": {
        "declaration": "TEXT PRIMARY KEY NOT NULL",
        "description": "Movement report identifier."
      },
      "flight_id": {
        "declaration": "TEXT NOT NULL REFERENCES flights(flight_id)",
        "description": "Operating leg."
      },
      "kind": {
        "declaration": "TEXT NOT NULL",
        "description": "EST = estimated off-block; OUT = actual off-block; AIR = actual take-off; LAND = actual landing; IN = actual in-block."
      },
      "value_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Timestamp represented by the message."
      },
      "received_at": {
        "declaration": "TEXT NOT NULL",
        "description": "Time the message was received."
      }
    }
  }
}
