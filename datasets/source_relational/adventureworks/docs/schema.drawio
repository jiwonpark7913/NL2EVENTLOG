        </mxCell>
        <mxCell id="lane0" value="01  SALES | offer / cart → order → order line" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="210" width="2908" height="1263" />
        </mxCell>
        <mxCell id="lane1" value="02  PROCUREMENT | supplier terms → purchase order → purchase line" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="1487" width="2908" height="469" />
        </mxCell>
        <mxCell id="lane2" value="03  MANUFACTURING | bill of materials → work order → operation / transaction" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="1970" width="2908" height="1096" />
        </mxCell>
        <mxCell id="lane3" value="04  PRODUCT | product lifecycle → effective prices / costs → review" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="3080" width="2908" height="1122" />
        </mxCell>
        <mxCell id="lane4" value="05  PEOPLE &amp; ORGANIZATION | employee → assignment / rate / territory history" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="4216" width="2908" height="1194" />
        </mxCell>
        <mxCell id="lane5" value="06  SHARED GEOGRAPHY | address → province → country" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="5424" width="2908" height="449" />
        </mxCell>
        <mxCell id="lane6" value="07  SYSTEM METADATA | technical times; separate from business processes" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
