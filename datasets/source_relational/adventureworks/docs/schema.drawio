        <mxCell id="note0" value="AdventureWorks | Business flow &amp;amp; physical schema" style="text;html=1;align=left;fontSize=27;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="36" y="16" width="2870" height="30" />
        </mxCell>
        <mxCell id="note1" value="71 tables / 90 declared FKs. Lanes group business context, not Entity Type equivalence. Orders, lines and operations retain distinct grains." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="36" y="46" width="2870" height="30" />
        </mxCell>
        <mxCell id="note2" value="SKY BLUE = non-ModifiedDate date/time (actual, planned, effective or descriptive). YELLOW = ModifiedDate maintenance time." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="36" y="76" width="2870" height="30" />
        </mxCell>
        <mxCell id="note3" value="Left: non-maintenance temporal columns. Right: ModifiedDate-only / no temporal columns. Arrows: child FK → referenced key; not process sequence." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="36" y="106" width="2870" height="30" />
        </mxCell>
        <mxCell id="level0" value="Temporal: anchor / lifecycle" style="text;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="36" y="160" width="420" height="32" />
        </mxCell>
        <mxCell id="level1" value="Temporal: order / effective period" style="text;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1">
