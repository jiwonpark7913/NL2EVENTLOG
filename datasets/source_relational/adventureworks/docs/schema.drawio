        </mxCell>
        <mxCell id="lane5" value="06  SHARED GEOGRAPHY | address → province → country" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
