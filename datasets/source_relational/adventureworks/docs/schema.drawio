        </mxCell>
        <mxCell id="level3" value="Reference: entity / snapshot" style="text;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1488" y="160" width="420" height="32" />
        </mxCell>
