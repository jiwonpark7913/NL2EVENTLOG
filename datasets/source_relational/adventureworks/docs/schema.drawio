        <mxCell id="lane0" value="01  SALES | offer / cart → order → order line" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="16" y="210" width="2908" height="1263" />
        </mxCell>
        <mxCell id="lane1" value="02  PROCUREMENT | supplier terms → purchase order → purchase line" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
