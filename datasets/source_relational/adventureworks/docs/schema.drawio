        <mxCell id="lane4" value="05  PEOPLE &amp; ORGANIZATION | employee → assignment / rate / territory history" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
