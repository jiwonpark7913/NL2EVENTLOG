        </mxCell>
        <mxCell id="lane2" value="03  MANUFACTURING | bill of materials → work order → operation / transaction" style="swimlane;startSize=44;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=20;fontStyle=1;fontSize=18;" vertex="1" parent="1">
