          "source_column": "AS_ROLLED_PLATE_NO"
        },
        {
          "name": "slab_id",
          "type": "TEXT",
          "constraints": "NOT NULL UNIQUE REFERENCES slab_material(slab_id)",
          "definition": "Source slab",
          "source_column": "SLAB_NO"
        },
        {
          "name": "instruction_id",
          "type": "TEXT",
          "constraints": "NOT NULL UNIQUE REFERENCES rolling_instruction(instruction_id)",
