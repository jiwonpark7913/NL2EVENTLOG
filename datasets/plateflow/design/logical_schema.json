{
  "original_source_design": [
    {
      "table": "slab_material",
      "source_table": "TB_M2EA08_C_MTL060",
      "definition": "Slab material and charge genealogy; no upstream operation timestamps in this subset",
      "columns": [
        {
          "name": "slab_id",
          "type": "TEXT",
          "constraints": "PRIMARY KEY",
          "definition": "Synthetic slab identity",
          "source_column": "MTL_NO"
        },
        {
          "name": "charge_id",
          "type": "TEXT",
          "constraints": "NOT NULL",
          "definition": "Upstream charge identity, contextual attribute",
          "source_column": "CHARGE_NO"
        }
      ]
    },
    {
      "table": "planned_rolling_instruction",
      "source_table": "TB_M2LB01_D_PLANINST010",
      "definition": "Scheduled rolling instruction; plan times do not prove execution",
      "columns": [
        {
          "name": "plan_id",
          "type": "TEXT",
          "constraints": "PRIMARY KEY",
          "definition": "Plan identity",
          "source_column": "PLATE_HR_WORK_DIR_ID"
        },
        {
          "name": "slab_id",
          "type": "TEXT",
          "constraints": "NOT NULL REFERENCES slab_material(slab_id)",
          "definition": "Planned input slab",
          "source_column": "SLAB_NO"
        },
        {
          "name": "planned_reheat_at",
          "type": "TEXT",
          "constraints": "NOT NULL",
          "definition": "Scheduled furnace charging time",
          "source_column": "PLT_RF_CH_SCHE_DT"
        }
      ]
    },
    {
      "table": "rolling_instruction",
      "source_table": "TB_M2LM01_D_INST010",
      "definition": "Released rolling work instruction, separate from planning",
      "columns": [
        {
          "name": "instruction_id",
          "type": "TEXT",
          "constraints": "PRIMARY KEY",
          "definition": "Synthetic row identity",
          "source_column": "WIP_ENTITY_ID"
        },
        {
          "name": "plan_id",
          "type": "TEXT",
          "constraints": "NOT NULL UNIQUE REFERENCES planned_rolling_instruction(plan_id)",
          "definition": "Synthetic explicit link to plan",
          "source_column": null
        },
        {
          "name": "released_at",
          "type": "TEXT",
          "constraints": "NOT NULL",
          "definition": "Actual instruction release time",
          "source_column": "OP_INDI_RELEASE_DT"
        }
      ]
    },
    {
      "table": "as_rolled_material",
