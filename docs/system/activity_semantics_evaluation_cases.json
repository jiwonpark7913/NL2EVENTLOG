      "value": "A",
      "expected_meaning": "Furnace heating",
      "contrast_table": "finishing_operation_history",
      "contrast_value": "A",
      "contrast_meaning": "Heat treatment",
      "expected_status": "supported",
      "gold_policy": "Existing Gold logs unchanged"
    },
    {
      "id": "WF-DD-CONFLICT",
      "dataset": "warehouseflow",
      "input": "evaluation/activity_semantics/conflicting_dictionary.json",
      "table": "request_action",
      "column": "action_code",
      "value": "A",
      "expected_status": "conflicting",
      "expected_behavior": "Detect contradictory DD vs FK code-table meaning; do not silently resolve to one label.",
      "gold_policy": "Semantic-status diagnostic only, excluded from normal event-log F1"
