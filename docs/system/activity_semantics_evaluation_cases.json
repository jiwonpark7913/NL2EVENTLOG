      "column": "action",
      "value": "E",
      "expected_status": "unresolved",
      "expected_behavior": "Without trustworthy code meaning, do not confidently assert Order Entered from the physical code alone.",
      "gold_policy": "Semantic-status diagnostic only, excluded from normal event-log F1"
    },
    {
      "id": "UF-SNAPSHOT",
      "dataset": "universityflow",
      "input": "baseline",
      "table": "registration",
      "column": "status",
      "value": "REGISTERED",
      "expected_status": "non-event",
      "expected_behavior": "Current registration status alone is not historical status-transition evidence.",
      "gold_policy": "Do not add synthetic status-change events to Gold"
    },
